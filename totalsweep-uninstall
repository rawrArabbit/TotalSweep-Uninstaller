#!/usr/bin/env bash
set -u

RPM_PACKAGE="totalsweep-uninstaller"

SOURCE_BIN="/usr/local/bin/totalsweep"
SOURCE_UNINSTALLER="/usr/local/bin/totalsweep-uninstall"
SOURCE_DESKTOP="/usr/local/share/applications/org.kde.totalsweep.desktop"
SOURCE_ICON="/usr/local/share/icons/hicolor/scalable/apps/org.kde.totalsweep.svg"

DATA_DIR="$HOME/.local/share/TotalSweep Uninstaller"
CONFIG_ROOT="${XDG_CONFIG_HOME:-$HOME/.config}/TotalSweep"
SETTINGS_FILE="$CONFIG_ROOT/Uninstaller.conf"

RPM_FOUND=0
SOURCE_FOUND=0
REMOVE_RPM=0
REMOVE_SOURCE=0
INSTALLATION_FOUND=0
REMOVAL_CANCELLED=0
REMOVAL_ERROR=0

usage() {
    cat <<'EOF_USAGE'
Usage:
  totalsweep-uninstall              Interactive removal menu
  totalsweep-uninstall --keep-data  Remove TotalSweep but preserve user data/settings
  totalsweep-uninstall --purge      Remove TotalSweep and permanently delete user data/settings
  totalsweep-uninstall --help       Show this help

The command automatically detects RPM and source installations.

If both installation types are found, TotalSweep asks which installed copy
or copies you want to remove instead of choosing for you.

The purge option removes TotalSweep-created Quarantine, History, package-cache,
staging/application-cache data, and saved application settings.

It does NOT remove source-code folders, downloaded release archives, shared
Fedora packages, or system dependencies.
EOF_USAGE
}

ensure_normal_user() {
    if [[ "$(id -u)" -eq 0 ]]; then
        echo "ERROR: Run totalsweep-uninstall as your normal desktop user, not with sudo."
        echo "The command will request administrator authorization when it needs it."
        return 1
    fi
}

ensure_not_running() {
    if pgrep -x totalsweep >/dev/null 2>&1; then
        echo
        echo "TotalSweep is currently running."
        echo "Close TotalSweep before uninstalling so it cannot recreate settings or data."
        echo
        return 1
    fi
}

rpm_installed() {
    rpm -q "$RPM_PACKAGE" >/dev/null 2>&1
}

source_installed() {
    [[ -e "$SOURCE_BIN" ||
       -e "$SOURCE_UNINSTALLER" ||
       -e "$SOURCE_DESKTOP" ||
       -e "$SOURCE_ICON" ]]
}

detect_installation_state() {
    RPM_FOUND=0
    SOURCE_FOUND=0

    rpm_installed && RPM_FOUND=1
    source_installed && SOURCE_FOUND=1
}

show_detected_installation() {
    detect_installation_state

    echo
    if [[ "$RPM_FOUND" -eq 1 && "$SOURCE_FOUND" -eq 1 ]]; then
        echo "Detected: RPM and source installations"
    elif [[ "$RPM_FOUND" -eq 1 ]]; then
        echo "Detected: RPM installation"
    elif [[ "$SOURCE_FOUND" -eq 1 ]]; then
        echo "Detected: source installation"
    else
        echo "Detected: no installed TotalSweep application"
        if [[ -e "$DATA_DIR" || -e "$SETTINGS_FILE" ]]; then
            echo "Saved TotalSweep user data/settings are still present."
        fi
    fi
}

prepare_removal() {
    local mode="${1:-keep}"

    detect_installation_state

    REMOVE_RPM=0
    REMOVE_SOURCE=0
    INSTALLATION_FOUND=0
    REMOVAL_CANCELLED=0
    REMOVAL_ERROR=0

    if [[ "$RPM_FOUND" -eq 1 && "$SOURCE_FOUND" -eq 1 ]]; then
        INSTALLATION_FOUND=1

        echo
        echo "Both RPM and source installations were detected."

        if [[ "$mode" == "purge" ]]; then
            echo "Complete removal must remove both installed copies because they share"
            echo "the same TotalSweep user data and settings."
            echo
            echo "  1) Remove both installations"
            echo "  0) Cancel"
            echo
            printf "Selection [0]: "

            IFS= read -r choice
            choice="${choice:-0}"

            case "$choice" in
                1)
                    REMOVE_RPM=1
                    REMOVE_SOURCE=1
                    ;;
                0)
                    REMOVAL_CANCELLED=1
                    echo "Uninstall cancelled. Nothing was changed."
                    ;;
                *)
                    REMOVAL_ERROR=1
                    echo "ERROR: Invalid selection. Nothing was changed."
                    ;;
            esac
        else
            echo "Choose which installed copy you want to remove:"
            echo
            echo "  1) RPM installation only"
            echo "  2) Source installation only"
            echo "  3) Both installations"
            echo "  0) Cancel"
            echo
            printf "Selection [0]: "

            IFS= read -r choice
            choice="${choice:-0}"

            case "$choice" in
                1)
                    REMOVE_RPM=1
                    ;;
                2)
                    REMOVE_SOURCE=1
                    ;;
                3)
                    REMOVE_RPM=1
                    REMOVE_SOURCE=1
                    ;;
                0)
                    REMOVAL_CANCELLED=1
                    echo "Uninstall cancelled. Nothing was changed."
                    ;;
                *)
                    REMOVAL_ERROR=1
                    echo "ERROR: Invalid selection. Nothing was changed."
                    ;;
            esac
        fi
    elif [[ "$RPM_FOUND" -eq 1 ]]; then
        INSTALLATION_FOUND=1
        REMOVE_RPM=1
    elif [[ "$SOURCE_FOUND" -eq 1 ]]; then
        INSTALLATION_FOUND=1
        REMOVE_SOURCE=1
    fi
}

refresh_desktop_database() {
    if command -v update-desktop-database >/dev/null 2>&1; then
        sudo update-desktop-database /usr/local/share/applications >/dev/null 2>&1 || true
    fi

    if command -v kbuildsycoca6 >/dev/null 2>&1; then
        kbuildsycoca6 >/dev/null 2>&1 || true
    fi
}

remove_rpm_installation() {
    local dnf_cmd=""

    if command -v dnf5 >/dev/null 2>&1; then
        dnf_cmd="dnf5"
    elif command -v dnf >/dev/null 2>&1; then
        dnf_cmd="dnf"
    else
        echo "ERROR: DNF is not available, so the RPM installation cannot be removed."
        return 1
    fi

    echo "Removing the RPM installation..."

    if [[ "$dnf_cmd" == "dnf5" ]]; then
        sudo "$dnf_cmd" remove --no-autoremove "$RPM_PACKAGE" || {
            echo "ERROR: The RPM installation could not be removed."
            return 1
        }
    else
        sudo "$dnf_cmd" remove --noautoremove "$RPM_PACKAGE" || {
            echo "ERROR: The RPM installation could not be removed."
            return 1
        }
    fi
}

remove_source_installation() {
    echo "Removing the source installation..."

    sudo rm -f -- \
        "$SOURCE_BIN" \
        "$SOURCE_DESKTOP" \
        "$SOURCE_ICON" || {
        echo "ERROR: One or more source-installed TotalSweep files could not be removed."
        return 1
    }

    refresh_desktop_database

    sudo rm -f -- "$SOURCE_UNINSTALLER" || {
        echo "ERROR: The installed TotalSweep uninstall command could not be removed."
        return 1
    }
}

perform_application_removal() {
    if [[ "$REMOVE_RPM" -eq 1 ]]; then
        remove_rpm_installation || return 1
    fi

    if [[ "$REMOVE_SOURCE" -eq 1 ]]; then
        remove_source_installation || return 1
    fi
}

print_preserved_data() {
    echo
    echo "Preserved:"

    [[ -e "$DATA_DIR" ]] && echo "  $DATA_DIR"
    [[ -e "$SETTINGS_FILE" ]] && echo "  $SETTINGS_FILE"

    if [[ ! -e "$DATA_DIR" && ! -e "$SETTINGS_FILE" ]]; then
        echo "  No TotalSweep user data/settings were present."
    fi
}

keep_data_core() {
    prepare_removal keep

    if [[ "$REMOVAL_ERROR" -eq 1 ]]; then
        return 1
    fi

    if [[ "$REMOVAL_CANCELLED" -eq 1 ]]; then
        return 0
    fi

    if [[ "$INSTALLATION_FOUND" -eq 1 ]]; then
        perform_application_removal || return 1
        echo
        echo "TotalSweep Uninstaller was removed successfully."
    else
        echo
        echo "No installed TotalSweep application was found."
    fi

    print_preserved_data
}

purge_core() {
    prepare_removal purge

    if [[ "$REMOVAL_ERROR" -eq 1 ]]; then
        return 1
    fi

    if [[ "$REMOVAL_CANCELLED" -eq 1 ]]; then
        return 0
    fi

    if [[ "$INSTALLATION_FOUND" -eq 0 &&
          ! -e "$DATA_DIR" &&
          ! -e "$SETTINGS_FILE" ]]; then
        echo
        echo "Nothing to remove. No TotalSweep installation or saved user data/settings were found."
        return 0
    fi

    echo
    echo "============================================================"
    echo " WARNING — COMPLETE TOTALSWEEP REMOVAL"
    echo "============================================================"
    echo
    echo "This will permanently remove:"

    if [[ "$INSTALLATION_FOUND" -eq 1 ]]; then
        echo "  - the selected TotalSweep installation"
    fi

    if [[ -e "$DATA_DIR" ]]; then
        echo "  - Quarantine, History, preserved package snapshots/cache"
        echo "  - staging/application cache data"
    fi

    if [[ -e "$SETTINGS_FILE" ]]; then
        echo "  - saved TotalSweep settings"
    fi

    echo
    echo "After this, TotalSweep will not be able to restore anything"
    echo "that existed only inside its Quarantine or package cache."
    echo
    echo "Source folders, downloaded release files, and shared Fedora"
    echo "packages or dependencies are left alone."
    echo

    printf 'Type PURGE to continue: '
    IFS= read -r answer

    if [[ "$answer" != "PURGE" ]]; then
        echo
        echo "Complete removal cancelled. Nothing was changed."
        return 0
    fi

    echo
    if [[ "$INSTALLATION_FOUND" -eq 1 ]]; then
        perform_application_removal || return 1
    fi

    if [[ -e "$DATA_DIR" ]]; then
        echo "Removing TotalSweep user data..."
        rm -rf -- "$DATA_DIR" || {
            echo "ERROR: Could not remove TotalSweep user data:"
            echo "$DATA_DIR"
            return 1
        }
    fi

    if [[ -e "$SETTINGS_FILE" ]]; then
        echo "Removing TotalSweep settings..."
        rm -f -- "$SETTINGS_FILE" || {
            echo "ERROR: Could not remove TotalSweep settings:"
            echo "$SETTINGS_FILE"
            return 1
        }
    fi

    rmdir -- "$CONFIG_ROOT" >/dev/null 2>&1 || true

    echo
    if [[ "$INSTALLATION_FOUND" -eq 1 ]]; then
        echo "TotalSweep Uninstaller and all TotalSweep-created user data/settings"
        echo "were removed successfully."
    else
        echo "Saved TotalSweep user data/settings were removed successfully."
    fi
}

keep_data() {
    ensure_normal_user || return 1
    ensure_not_running || return 1
    show_detected_installation
    keep_data_core
}

purge_all() {
    ensure_normal_user || return 1
    ensure_not_running || return 1
    show_detected_installation
    purge_core
}

interactive_menu() {
    ensure_normal_user || return 1
    ensure_not_running || return 1

    echo "============================================================"
    echo " TotalSweep Uninstaller — Uninstall"
    echo "============================================================"

    show_detected_installation

    echo
    echo "Choose what you want to remove:"
    echo
    echo "  1) Remove TotalSweep but KEEP Quarantine, History, cache, and settings"
    echo "  2) COMPLETELY remove TotalSweep and all TotalSweep-created user data/settings"
    echo "  0) Cancel"
    echo
    printf "Selection [1]: "

    IFS= read -r choice
    choice="${choice:-1}"

    case "$choice" in
        1)
            keep_data_core
            ;;
        2)
            purge_core
            ;;
        0)
            echo "Uninstall cancelled."
            ;;
        *)
            echo "ERROR: Invalid selection."
            return 1
            ;;
    esac
}

case "${1:-}" in
    "")
        interactive_menu
        ;;
    --keep-data)
        keep_data
        ;;
    --purge)
        purge_all
        ;;
    --help|-h)
        usage
        ;;
    *)
        echo "ERROR: Unknown option: $1"
        echo
        usage
        exit 2
        ;;
esac
